		 FROM _users_ WHERE _id_ = $1`, id,
	).Scan(&u._ID_, &u._Username_, &u._Email_, &u._Password_, &u._FirstName_, &u._LastName_, &u._IsActive_, &u._CreatedAt_, &u._UpdatedAt_)
