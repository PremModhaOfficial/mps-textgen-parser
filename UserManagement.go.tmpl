	return _users_, rows.Err()
}

func (r *_UserRepo_) Update(u *_User_) error {
	return r.db.QueryRow(
		`UPDATE _users_ SET _username_ = $1, _email_ = $2, _password_ = $3, _first_name_ = $4, _last_name_ = $5, _is_active_ = $6, _updated_at_ = NOW()
